{
  "name": "mallory-ts",
  "version": "0.1.0",
  "description": "Advanced college-level mathematics library — a modern TypeScript port of the Mallory ActionScript 3 library.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "test:build": "npm run build && node --test dist-test/**/*.test.js"
  },
  "keywords": [
    "math",
    "complex-numbers",
    "linear-algebra",
    "matrix",
    "permutation",
    "group-theory",
    "polynomial",
    "expression-parser"
  ],
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
